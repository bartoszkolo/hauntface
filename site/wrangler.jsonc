// Cloudflare Workers — static assets only (no worker script).
// Build first: `bash build.sh`, then `npx wrangler deploy` from this folder.
{
  "name": "hauntface",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "hauntface.com", "custom_domain": true },
    { "pattern": "www.hauntface.com", "custom_domain": true }
  ]
}
